generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String             @id @default(cuid())
  name                       String
  email                      String             @unique
  passwordHash               String
  mustChangePassword         Boolean            @default(false)
  phone                      String?
  profession                 String?
  practiceArea               String?
  hasSecretary               Boolean?
  failedLogins               Int                @default(0)
  lockedUntil                DateTime?          @db.Timestamptz(6)
  emailVerifiedAt            DateTime?          @db.Timestamptz(6)
  emailVerificationTokenHash String?            @unique
  emailVerificationExpiresAt DateTime?          @db.Timestamptz(6)
  role                       UserRole           @default(ADMIN)
  createdAt                  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                ClinicMembership[]
}

model Clinic {
  id                          String               @id @default(cuid())
  name                        String
  slug                        String               @unique
  laborCost                   Int                  @default(0)
  facilityCost                Int                  @default(0)
  medicationCost              Int                  @default(0)
  appointmentToleranceMinutes Int                  @default(15)
  openingTime                 String               @default("08:00")
  closingTime                 String               @default("19:00")
  professionalOpeningTime     String               @default("09:00")
  professionalClosingTime     String               @default("18:00")
  professionalHourlyCost      Float                @default(0)
  expiryWarningDays           Int                  @default(30)
  trialStartedAt              DateTime?            @db.Timestamptz(6)
  trialEndsAt                 DateTime?            @db.Timestamptz(6)
  createdAt                   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                 ClinicMembership[]
  patients                    Patient[]
  appointments                Appointment[]
  procedures                  Procedure[]
  evaluations                 Evaluation[]
  quotes                      Quote[]
  payments                    Payment[]
  products                    Product[]
  patientProcedures           PatientProcedure[]
  procedureSessions           PatientProcedureSession[]
  procedureFollowUps           PatientProcedureFollowUp[]
  journeys                    PatientJourney[]
  stockLots                   StockLot[]
  stockMovements              StockMovement[]
  expenses                    Expense[]
  purchases                   Purchase[]
  recurringExpenses           RecurringExpense[]
  pendingStockOutputs         PendingStockOutput[]
}

model ClinicMembership {
  id       String   @id @default(cuid())
  userId   String
  clinicId String
  role     UserRole @default(STAFF)
  isOwner  Boolean  @default(false)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model Patient {
  id                  String               @id @default(cuid())
  clinicId            String?
  name                String
  cpf                 String?
  phone               String
  age                 Int
  status              String               @default("Ativa")
  lastVisit           DateTime?            @db.Timestamptz(6)
  nextReturn          DateTime?            @db.Timestamptz(6)
  totalValue          Int                  @default(0)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  appointments        Appointment[]
  evaluations         Evaluation[]
  quotes              Quote[]
  payments            Payment[]
  procedureRecords    PatientProcedure[]
  procedureSessions   PatientProcedureSession[]
  procedureFollowUps  PatientProcedureFollowUp[]
  observations        PatientObservation[]
  journeys            PatientJourney[]
  stockMovements      StockMovement[]
  pendingStockOutputs PendingStockOutput[]
  clinic              Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([clinicId, cpf])
  @@index([clinicId])
  @@index([clinicId, name])
}

model PatientObservation {
  id         String   @id @default(cuid())
  clinicId   String
  patientId  String
  text       String
  authorName String
  kind       String   @default("clinical")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clinicId, patientId, createdAt])
}

model Appointment {
  id                  String               @id @default(cuid())
  clinicId            String?
  date                DateTime             @db.Timestamptz(6)
  time                String
  patientId           String
  journeyId           String?
  procedure           String
  professional        String
  notes               String               @default("")
  status              String
  materialsCheck      String?
  materialsCheckedAt  DateTime?            @db.Timestamptz(6)
  stockMovements      StockMovement[]
  pendingStockOutputs PendingStockOutput[]
  procedureFollowUp   PatientProcedureFollowUp?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey             PatientJourney?      @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clinic              Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId, date])
  @@index([journeyId, date])
  @@index([clinicId])
  @@index([clinicId, date, time])
}

model Procedure {
  id                  String              @id @default(cuid())
  clinicId            String?
  name                String
  category            String
  price               Int
  durationMinutes     Int
  materials           String
  materialsNeedReview Boolean             @default(false)
  margin              Float
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  clinic              Clinic?             @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technicalSheet      ProcedureMaterial[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model PatientProcedure {
  id            String                         @id @default(cuid())
  clinicId      String?
  patientId     String
  journeyId     String?
  quoteId       String?                        @unique
  name          String
  professional  String
  performedAt   DateTime                       @db.Timestamptz(6)
  notes         String                         @default("")
  beforePhoto   String?
  afterPhoto    String?
  createdAt     DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                       @updatedAt @db.Timestamptz(6)
  clinic        Clinic?                        @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient       Patient                        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey       PatientJourney?                @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  photoSessions PatientProcedurePhotoSession[]
  sessions      PatientProcedureSession[]

  @@index([clinicId])
  @@index([patientId, performedAt])
  @@index([journeyId, performedAt])
}

model PatientProcedurePhotoSession {
  id          String           @id @default(cuid())
  procedureId String
  name        String
  beforePhoto String?
  afterPhoto  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  procedure   PatientProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([procedureId, createdAt])
}

model PatientProcedureSession {
  id               String           @id @default(cuid())
  clinicId         String
  patientId        String
  journeyId        String
  evaluationId     String
  procedureId      String
  quoteId          String
  procedureName    String
  technique        String           @default("")
  treatedAreas     String           @default("")
  professional     String
  performedAt      DateTime         @db.Timestamptz(6)
  startedAt        DateTime?        @db.Timestamptz(6)
  endedAt          DateTime?        @db.Timestamptz(6)
  estimatedMinutes Int?
  durationMinutes  Int?
  anesthesia       String           @default("")
  complications    String           @default("")
  observations     String           @default("")
  materials        String           @default("[]")
  photos           String           @default("[]")
  auditLog         String           @default("[]")
  status           String           @default("Rascunho")
  createdBy        String
  updatedBy        String
  completedBy      String?
  completedAt      DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  clinic           Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey          PatientJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluation       Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  procedure        PatientProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quote            Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stockMovements   StockMovement[]
  pendingOutputs   PendingStockOutput[]
  followUps        PatientProcedureFollowUp[]
  followUpDraft    PatientProcedureFollowUpDraft?

  @@index([clinicId, patientId, performedAt])
  @@index([journeyId, performedAt])
  @@index([procedureId, performedAt])
  @@index([evaluationId])
  @@index([quoteId])
}

model Evaluation {
  id                 String            @id @default(cuid())
  clinicId           String?
  patientId          String
  journeyId          String?
  professional       String            @default("")
  chiefComplaint     String            @default("")
  patientGoal        String            @default("")
  medicalHistory     String            @default("")
  allergies          String            @default("")
  pregnancyStatus    String            @default("")
  anticoagulantUse   String            @default("")
  autoimmuneDiseases String            @default("")
  contraindications  String            @default("")
  previousProcedures String            @default("")
  clinicalNotes      String            @default("")
  status             String            @default("Rascunho")
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey            PatientJourney?   @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  photos             EvaluationPhoto[]
  procedureSessions  PatientProcedureSession[]
  quotes             Quote[]
  clinic             Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId])
  @@index([clinicId])
  @@index([journeyId])
}

model Product {
  id             String               @id @default(cuid())
  clinicId       String?
  name           String
  category       String
  unit           String
  costCents      Int                  @default(0)
  /// Legacy compatibility column, synchronized with costCents by a PostgreSQL trigger.
  cost           Int?                 @ignore
  minStock       Float                @default(0)
  archivedAt     DateTime?            @db.Timestamptz(6)
  supplier       String
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  clinic         Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lots           StockLot[]
  movements      StockMovement[]
  procedures     ProcedureMaterial[]
  pendingOutputs PendingStockOutput[]
  purchaseItems  PurchaseItem[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Quote {
  id            String          @id @default(cuid())
  clinicId      String?
  patientId     String?
  journeyId     String?
  evaluationId  String?
  items         String
  details       String          @default("[]")
  notes         String          @default("")
  installments  Int             @default(1)
  totalCents    Int
  paymentMethod String          @default("Cartão de crédito")
  status        String          @default("Pendente")
  createdBy     String          @default("")
  updatedBy     String          @default("")
  approvedBy    String?
  approvedAt    DateTime?       @db.Timestamptz(6)
  sentBy        String?
  sentAt        DateTime?       @db.Timestamptz(6)
  refusedBy     String?
  refusedAt     DateTime?       @db.Timestamptz(6)
  cancelledBy   String?
  cancelledAt   DateTime?       @db.Timestamptz(6)
  expires       DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic        Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient       Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  journey       PatientJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  evaluation    Evaluation?     @relation(fields: [evaluationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  procedureSessions PatientProcedureSession[]

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([journeyId])
  @@index([evaluationId])
}

model Payment {
  id           String          @id @default(cuid())
  clinicId     String?
  patientId    String?
  journeyId    String?
  valueCents   Int
  method       String
  date         DateTime        @default(now()) @db.Timestamptz(6)
  status       String          @default("Pago")
  installments String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic       Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient      Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  journey      PatientJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clinicId])
  @@index([clinicId, date])
  @@index([patientId])
  @@index([journeyId])
}

model EvaluationPhoto {
  id           String     @id @default(cuid())
  evaluationId String
  name         String
  imageUrl     String
  width        Int
  height       Int
  category     String     @default("Outra")
  sortOrder    Int        @default(0)
  annotations  String     @default("[]")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([evaluationId])
}

model PatientJourney {
  id           String             @id @default(cuid())
  patientId    String
  clinicId     String?
  name         String
  professional String             @default("")
  status       String             @default("Em andamento")
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  archivedAt   DateTime?          @db.Timestamptz(6)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic       Clinic?            @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]
  evaluations  Evaluation[]
  quotes       Quote[]
  payments     Payment[]
  procedures   PatientProcedure[]
  procedureSessions PatientProcedureSession[]
  procedureFollowUps PatientProcedureFollowUp[]

  @@index([patientId, createdAt])
  @@index([clinicId])
}

model PatientProcedureFollowUp {
  id             String                  @id @default(cuid())
  clinicId       String
  patientId      String
  journeyId      String
  sessionId      String
  appointmentId  String?                 @unique
  occurredAt     DateTime                @default(now()) @db.Timestamptz(6)
  professional   String
  guidanceText   String                  @default("")
  guidanceSentAt DateTime?               @db.Timestamptz(6)
  observations   String                  @default("")
  complications  String                  @default("")
  photos         String                  @default("[]")
  auditLog       String                  @default("[]")
  createdBy      String
  updatedBy      String
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)
  clinic         Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey        PatientJourney          @relation(fields: [journeyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session        PatientProcedureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment    Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clinicId, patientId, occurredAt])
  @@index([journeyId, occurredAt])
  @@index([sessionId, occurredAt])
}

model PatientProcedureFollowUpDraft {
  sessionId         String                  @id
  guidanceText      String                  @default("")
  guidanceConfirmed Boolean                 @default(false)
  observations      String                  @default("")
  complications     String                  @default("")
  photos            String                  @default("[]")
  appointmentId     String?
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)
  session           PatientProcedureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model StockLot {
  id            String          @id @default(cuid())
  clinicId      String
  productId     String
  code          String
  expiresOn     DateTime        @db.Date
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movements     StockMovement[]
  purchaseItems PurchaseItem[]

  @@unique([productId, code])
  @@index([clinicId])
}

model StockMovement {
  id             String         @id @default(cuid())
  clinicId       String
  productId      String
  lotId          String
  type           String
  quantity       Float
  reason         String?
  notes          String         @default("")
  userId         String?
  userName       String         @default("")
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lot            StockLot       @relation(fields: [lotId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseId     String?
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointmentId  String?
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  procedureSessionId String?
  procedureSession PatientProcedureSession? @relation(fields: [procedureSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  patientId      String?
  patient        Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attendanceKind String?
  attendanceName String?
  attendanceDate DateTime?      @db.Timestamptz(6)
  reversesId     String?        @unique
  reverses       StockMovement? @relation("StockReversal", fields: [reversesId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reversedBy     StockMovement? @relation("StockReversal")

  @@index([appointmentId])
  @@index([patientId])
  @@index([lotId])
  @@index([clinicId, createdAt])
  @@index([productId, createdAt])
  @@index([procedureSessionId])
}

model Expense {
  id                 String            @id @default(cuid())
  clinicId           String
  description        String
  category           String
  amountCents        Int
  dueOn              DateTime          @db.Date
  paymentMethod      String
  status             String            @default("open")
  paidOn             DateTime?         @db.Date
  source             String            @default("manual")
  createdById        String?
  purchaseId         String?
  installmentNumber  Int?
  purchase           Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recurringExpenseId String?
  occurrenceOn       DateTime?         @db.Date
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  clinic             Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recurringExpenseId, occurrenceOn])
  @@index([clinicId, dueOn])
  @@index([clinicId, paidOn])
}

model ProcedureMaterial {
  id          String    @id @default(cuid())
  procedureId String
  productId   String
  quantity    Float
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([procedureId, productId])
  @@index([productId])
}

model Purchase {
  id            String          @id @default(cuid())
  clinicId      String
  supplier      String
  invoiceNumber String?
  purchasedOn   DateTime        @db.Date
  paymentMethod String
  installments  Int             @default(1)
  status        String          @default("active")
  userId        String?
  userName      String          @default("")
  cancelledAt   DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items         PurchaseItem[]
  expenses      Expense[]
  movements     StockMovement[]

  @@index([clinicId, purchasedOn])
}

model PurchaseItem {
  id             String   @id @default(cuid())
  purchaseId     String
  productId      String
  lotId          String
  quantity       Float
  unitPriceCents Int
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lot            StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([purchaseId])
  @@index([productId])
  @@index([lotId])
}

model RecurringExpense {
  id            String    @id @default(cuid())
  clinicId      String
  description   String
  category      String
  amountCents   Int
  paymentMethod String
  frequency     String
  weekday       Int?
  dayOfMonth    Int?
  month         Int?
  startsOn      DateTime  @db.Date
  endsOn        DateTime? @db.Date
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses      Expense[]

  @@index([clinicId])
}

model PendingStockOutput {
  id             String       @id @default(cuid())
  clinicId       String
  productId      String
  appointmentId  String?
  procedureSessionId String?
  patientId      String?
  quantity       Float
  status         String       @default("pending")
  attendanceKind String
  attendanceName String
  attendanceDate DateTime     @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime?    @db.Timestamptz(6)
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  procedureSession PatientProcedureSession? @relation(fields: [procedureSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  patient        Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clinicId, status])
  @@index([appointmentId])
  @@index([procedureSessionId])
}

enum UserRole {
  ADMIN
  PROFESSIONAL
  STAFF
}
