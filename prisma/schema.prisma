generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String             @id @default(cuid())
  name                       String
  email                      String             @unique
  passwordHash               String
  mustChangePassword         Boolean            @default(false)
  phone                      String?
  profession                 String?
  practiceArea               String?
  hasSecretary               Boolean?
  emailVerifiedAt            DateTime?          @db.Timestamptz(6)
  emailVerificationTokenHash String?            @unique
  emailVerificationExpiresAt DateTime?          @db.Timestamptz(6)
  role                       UserRole           @default(ADMIN)
  createdAt                  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                ClinicMembership[]
}

model Clinic {
  id                          String             @id @default(cuid())
  name                        String
  slug                        String             @unique
  laborCost                   Int                @default(0)
  facilityCost                Int                @default(0)
  medicationCost              Int                @default(0)
  appointmentToleranceMinutes Int                @default(15)
  openingTime                 String             @default("08:00")
  closingTime                 String             @default("19:00")
  professionalOpeningTime     String             @default("09:00")
  professionalClosingTime     String             @default("18:00")
  professionalHourlyCost      Float              @default(0)
  trialStartedAt              DateTime?          @db.Timestamptz(6)
  trialEndsAt                 DateTime?          @db.Timestamptz(6)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  memberships                 ClinicMembership[]
  patients                    Patient[]
  appointments                Appointment[]
  procedures                  Procedure[]
  evaluations                 Evaluation[]
  quotes                      Quote[]
  payments                    Payment[]
  products                    Product[]
  patientProcedures           PatientProcedure[]
  journeys                    PatientJourney[]
}

model ClinicMembership {
  id       String   @id @default(cuid())
  userId   String
  clinicId String
  role     UserRole @default(STAFF)
  isOwner  Boolean  @default(false)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model Patient {
  id               String             @id @default(cuid())
  clinicId         String?
  name             String
  cpf              String?
  phone            String
  age              Int
  status           String             @default("Ativa")
  lastVisit        DateTime?          @db.Timestamptz(6)
  nextReturn       DateTime?          @db.Timestamptz(6)
  totalValue       Int                @default(0)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  appointments     Appointment[]
  evaluations      Evaluation[]
  quotes           Quote[]
  payments         Payment[]
  procedureRecords PatientProcedure[]
  journeys         PatientJourney[]
  clinic           Clinic?            @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clinicId])
  @@index([clinicId, name])
  @@unique([clinicId, cpf])
}

model Appointment {
  id           String          @id @default(cuid())
  clinicId     String?
  date         DateTime        @db.Timestamptz(6)
  time         String
  patientId    String
  journeyId    String?
  procedure    String
  professional String
  notes        String          @default("")
  status       String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey      PatientJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  clinic       Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId, date])
  @@index([journeyId, date])
  @@index([clinicId])
  @@index([clinicId, date, time])
}

model Procedure {
  id              String   @id @default(cuid())
  clinicId        String?
  name            String
  category        String
  price           Int
  durationMinutes Int
  materials       String
  margin          Float
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  clinic          Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clinicId])
  @@unique([clinicId, name])
}

model PatientProcedure {
  id            String                         @id @default(cuid())
  clinicId      String?
  patientId     String
  journeyId     String?
  name          String
  professional  String
  performedAt   DateTime                       @db.Timestamptz(6)
  notes         String                         @default("")
  beforePhoto   String?
  afterPhoto    String?
  createdAt     DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                       @updatedAt @db.Timestamptz(6)
  clinic        Clinic?                        @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient       Patient                        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey       PatientJourney?                @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  photoSessions PatientProcedurePhotoSession[]

  @@index([clinicId])
  @@index([patientId, performedAt])
  @@index([journeyId, performedAt])
}

model PatientProcedurePhotoSession {
  id          String           @id @default(cuid())
  procedureId String
  name        String
  beforePhoto String?
  afterPhoto  String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  procedure   PatientProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([procedureId, createdAt])
}

model Evaluation {
  id        String            @id @default(cuid())
  clinicId  String?
  patientId String
  journeyId String?
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journey   PatientJourney?   @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  photos    EvaluationPhoto[]
  clinic    Clinic?           @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId])
  @@index([clinicId])
  @@index([journeyId])
}

model Product {
  id        String   @id @default(cuid())
  clinicId  String?
  name      String
  category  String
  unit      String
  cost      Int
  supplier  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clinicId])
  @@unique([clinicId, name])
}

model Quote {
  id            String          @id @default(cuid())
  clinicId      String?
  patientId     String?
  journeyId     String?
  items         String
  total         Int
  paymentMethod String          @default("Cartão de crédito")
  status        String          @default("Pendente")
  expires       DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic        Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient       Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  journey       PatientJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([journeyId])
}

model Payment {
  id           String          @id @default(cuid())
  clinicId     String?
  patientId    String?
  journeyId    String?
  value        Int
  method       String
  date         DateTime        @default(now()) @db.Timestamptz(6)
  status       String          @default("Pago")
  installments String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  clinic       Clinic?         @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient      Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  journey      PatientJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clinicId])
  @@index([clinicId, date])
  @@index([patientId])
  @@index([journeyId])
}

model EvaluationPhoto {
  id           String     @id @default(cuid())
  evaluationId String
  name         String
  imageUrl     String
  width        Int
  height       Int
  annotations  String     @default("[]")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([evaluationId])
}

model PatientJourney {
  id           String             @id @default(cuid())
  patientId    String
  clinicId     String?
  name         String
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  archivedAt   DateTime?          @db.Timestamptz(6)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic       Clinic?            @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]
  evaluations  Evaluation[]
  quotes       Quote[]
  payments     Payment[]
  procedures   PatientProcedure[]

  @@index([patientId, createdAt])
  @@index([clinicId])
}

enum UserRole {
  ADMIN
  PROFESSIONAL
  STAFF
}
